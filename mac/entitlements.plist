<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime exceptions for an embedded Python (PyInstaller) + Qt:
	     ctypes/libffi closures need writable+executable memory; JIT for Python 3.12's perf hooks and
	     Qt's JS engine paths; library validation off so the downloaded, separately signed engine
	     libraries (PyTorch etc. in ~/Library/Application Support) could be loaded if ever needed. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
